<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container" style="max-width: 900px;">
  <div class="page-header">
    <div>
      <h1 class="page-title">Ask Your Bills</h1>
      <p class="page-subtitle">Ask questions about your uploaded invoices, taxes, vendors, and expenses in plain English.</p>
    </div>
    <div>
      <span class="badge badge-info">
        <%= billsCount %> Invoices Indexed
      </span>
    </div>
  </div>

  <!-- Prompt Pills for Instant Audit Queries -->
  <div class="prompt-pills">
    <button type="button" class="prompt-pill" onclick="sendPrompt('How much total tax have I paid so far across all bills?')">
      "How much total tax have I paid so far?"
    </button>
    <button type="button" class="prompt-pill" onclick="sendPrompt('Which bills are currently unpaid or due?')">
      "Which bills are currently unpaid or due?"
    </button>
    <button type="button" class="prompt-pill" onclick="sendPrompt('How much have I spent on each category?')">
      "How much have I spent on each category?"
    </button>
    <button type="button" class="prompt-pill" onclick="sendPrompt('What are my top 3 highest expense bills?')">
      "What are my top 3 highest expense bills?"
    </button>
  </div>

  <!-- Chat Container -->
  <div class="chat-container">
    <div id="chat-messages" class="chat-messages">
      <div class="chat-bubble assistant">
        <strong>Assistant:</strong>
        <p style="margin-top: 0.35rem; line-height: 1.5;">
          Hello! I have indexed your <%= billsCount %> uploaded bills. You can ask me any question about your spending totals, tax credits, vendor charges, or due dates.
        </p>
      </div>
    </div>

    <!-- Input Form -->
    <form id="chat-form" class="chat-input-area">
      <input 
        type="text" 
        id="chat-input" 
        class="form-control" 
        placeholder="Ask a question about your bills (e.g. 'How much did I spend this month?')..." 
        autocomplete="off" 
        required
      >
      <button type="submit" id="chat-submit-btn" class="btn btn-primary" style="padding: 0 1.5rem;">
        Send
      </button>
    </form>
  </div>
</div>

<script>
  const chatMessages = document.getElementById('chat-messages');
  const chatForm = document.getElementById('chat-form');
  const chatInput = document.getElementById('chat-input');
  const chatSubmitBtn = document.getElementById('chat-submit-btn');

  function scrollToBottom() {
    requestAnimationFrame(() => {
      chatMessages.scrollTo({
        top: chatMessages.scrollHeight,
        behavior: 'smooth'
      });
      setTimeout(() => {
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }, 100);
    });
  }

  function appendMessage(sender, text, isUser = false) {
    const bubble = document.createElement('div');
    bubble.className = `chat-bubble ${isUser ? 'user' : 'assistant'}`;
    
    if (isUser) {
      bubble.textContent = text;
    } else {
      bubble.innerHTML = `<strong>Assistant:</strong><div style="margin-top: 0.35rem; line-height: 1.5; white-space: pre-line;">${formatMarkdown(text)}</div>`;
    }

    chatMessages.appendChild(bubble);
    scrollToBottom();
    return bubble;
  }

  function formatMarkdown(text) {
    return text
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.*?)\*/g, '<em>$1</em>')
      .replace(/`([^`]+)`/g, '<code>$1</code>');
  }

  window.sendPrompt = function(promptText) {
    chatInput.value = promptText;
    chatForm.dispatchEvent(new Event('submit'));
  };

  chatForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const query = chatInput.value.trim();
    if (!query) return;

    appendMessage('You', query, true);
    chatInput.value = '';
    chatSubmitBtn.disabled = true;

    // Loading indicator
    const loadingBubble = appendMessage('Assistant', 'Analyzing your bills...');

    try {
      const response = await fetch('/api/chat/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question: query })
      });

      const data = await response.json();
      loadingBubble.remove();

      if (data.success) {
        appendMessage('Assistant', data.answer);
      } else {
        appendMessage('Assistant', data.message || 'Unable to analyze bills for this question.');
      }
    } catch (err) {
      loadingBubble.remove();
      appendMessage('Assistant', 'Unable to reach the assistant right now. Please check your connection and try again.');
    } finally {
      chatSubmitBtn.disabled = false;
      chatInput.focus();
      scrollToBottom();
    }
  });
</script>

<%- include('partials/footer') %>
