<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container" style="max-width: 960px;">
  <div class="page-header">
    <div>
      <h1 class="page-title">💬 "Ask Your Bills" Natural Language Local RAG Chat</h1>
      <p class="page-subtitle">Query your uploaded invoices, tax amounts, vendor expenditures, and payment statuses using conversational AI.</p>
    </div>
    <div>
      <span class="badge badge-info">
        RAG Database: <%= billsCount %> Invoices Loaded
      </span>
    </div>
  </div>

  <!-- Prompt Pills for Instant Audit Queries -->
  <div class="prompt-pills">
    <button class="prompt-pill" onclick="sendPrompt('How much total tax (GST/VAT) have I paid so far across all bills?')">
      💡 "How much total tax have I paid so far?"
    </button>
    <button class="prompt-pill" onclick="sendPrompt('Which bills are currently unpaid or overdue?')">
      ⏳ "Which bills are currently unpaid or overdue?"
    </button>
    <button class="prompt-pill" onclick="sendPrompt('How much did I spend on Hardware vs Software?')">
      💻 "How much did I spend on Hardware vs Software?"
    </button>
    <button class="prompt-pill" onclick="sendPrompt('List all invoices that have math calculation discrepancies.')">
      🔴 "List all invoices with math calculation errors."
    </button>
    <button class="prompt-pill" onclick="sendPrompt('What are the top 3 highest expenditure invoices?')">
      🏆 "What are the top 3 highest expenditure invoices?"
    </button>
  </div>

  <!-- Chat Container -->
  <div class="chat-container">
    <div id="chat-messages" class="chat-messages">
      <div class="chat-bubble assistant">
        <strong>🤖 AuditAI:</strong>
        <p style="margin-top: 0.4rem;">
          Hello! I have loaded your <%= billsCount %> uploaded invoices and tax records into memory.
          You can ask me anything about your expenditures, specific vendor payments, input tax credits (GST/VAT), or audit discrepancies.
        </p>
        <small style="color: var(--text-muted); display: block; margin-top: 0.5rem;">
          AI Mode: <strong><%= preferredProvider.toUpperCase() %></strong> &bull; RAG Context: Active
        </small>
      </div>
    </div>

    <!-- Input Form -->
    <form id="chat-form" class="chat-input-area">
      <input type="text" id="chat-input" class="form-control" placeholder="Ask a question about your bills (e.g., 'How much tax did I pay on hardware in September?')..." autocomplete="off" required>
      <button type="submit" id="chat-submit-btn" class="btn btn-primary" style="padding: 0 1.5rem;">
        Send 🚀
      </button>
    </form>
  </div>
</div>

<script>
  const chatMessages = document.getElementById('chat-messages');
  const chatForm = document.getElementById('chat-form');
  const chatInput = document.getElementById('chat-input');
  const chatSubmitBtn = document.getElementById('chat-submit-btn');

  function appendMessage(sender, text, isUser = false) {
    const bubble = document.createElement('div');
    bubble.className = `chat-bubble ${isUser ? 'user' : 'assistant'}`;
    
    if (isUser) {
      bubble.textContent = text;
    } else {
      bubble.innerHTML = `<strong>🤖 AuditAI:</strong><div style="margin-top: 0.35rem; white-space: pre-line;">${formatMarkdown(text)}</div>`;
    }

    chatMessages.appendChild(bubble);
    chatMessages.scrollTop = chatMessages.scrollHeight;
    return bubble;
  }

  function formatMarkdown(text) {
    // Quick sanitizing and formatting bold and bullet points
    return text
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.*?)\*/g, '<em>$1</em>')
      .replace(/`([^`]+)`/g, '<code>$1</code>');
  }

  window.sendPrompt = function(promptText) {
    chatInput.value = promptText;
    chatForm.dispatchEvent(new Event('submit'));
  };

  chatForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const query = chatInput.value.trim();
    if (!query) return;

    appendMessage('You', query, true);
    chatInput.value = '';
    chatSubmitBtn.disabled = true;

    // Loading indicator
    const loadingBubble = appendMessage('AuditAI', 'Analyzing verified invoice metadata and computing audit figures...');

    try {
      const response = await fetch('/api/chat/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question: query })
      });

      const data = await response.json();
      loadingBubble.remove();

      if (data.success) {
        appendMessage('AuditAI', data.answer);
      } else {
        appendMessage('AuditAI', `⚠️ Error: ${data.message || 'Could not process query'}`);
      }
    } catch (err) {
      loadingBubble.remove();
      appendMessage('AuditAI', `❌ Network error while communicating with AI service: ${err.message}`);
    } finally {
      chatSubmitBtn.disabled = false;
      chatInput.focus();
    }
  });
</script>

<%- include('partials/footer') %>

