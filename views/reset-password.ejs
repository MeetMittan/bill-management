<%- include('partials/header') %>

<div class="auth-container">
  <div class="card auth-card" style="max-width: 440px;">
    <div class="card-header auth-card-header">
      <h2 style="font-size: 1.35rem; font-weight: 700; color: var(--dark); margin: 0;">Set New Password</h2>
      <p style="font-size: 0.875rem; color: var(--text-muted); margin-top: 0.25rem;">
        <% if (typeof email !== 'undefined' && email) { %>
          Resetting password for <strong><%= email %></strong>
        <% } else { %>
          Enter your email, reset code, and your new password.
        <% } %>
      </p>
    </div>

    <div class="card-body auth-card-body">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-box alert-error">
          <%= error %>
        </div>
      <% } %>

      <% if (typeof isNetworkBlocked !== 'undefined' && isNetworkBlocked && typeof devOtp !== 'undefined' && devOtp) { %>
        <div id="networkBlockedNotice" style="background-color: #fffbeb; border: 1px solid #fde68a; color: #92400e; padding: 0.85rem 1rem; border-radius: var(--radius-sm); margin-bottom: 1.25rem; font-size: 0.85rem; line-height: 1.45;">
          <div style="font-weight: 700; margin-bottom: 0.25rem; display: flex; align-items: center; gap: 0.35rem;">
            <span>⚠️</span> <span>Campus / Wi-Fi Firewall Active</span>
          </div>
          <div style="font-size: 0.8rem; color: #78350f; margin-bottom: 0.5rem;">
            Your network firewall blocked outbound SMTP mail ports. For immediate reset, use your verification code below:
          </div>
          <div style="background: #fef3c7; border: 1px dashed #d97706; padding: 0.5rem; text-align: center; border-radius: 4px; font-family: monospace; font-weight: 800; font-size: 1.35rem; letter-spacing: 3px; color: #78350f;">
            <%= devOtp %>
          </div>
          <div style="font-size: 0.75rem; color: #92400e; margin-top: 0.4rem; text-align: center;">
            💡 <em>Tip: Switch to mobile hotspot to receive emails directly into your Gmail inbox.</em>
          </div>
        </div>
      <% } else if (typeof devOtp !== 'undefined' && devOtp) { %>
        <div style="background-color: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 0.75rem 1rem; border-radius: var(--radius-sm); margin-bottom: 1.25rem; font-size: 0.85rem; text-align: center;">
          <strong>Reset Code:</strong> <span style="font-family: monospace; font-weight: 700; font-size: 1.15rem; letter-spacing: 2px;"><%= devOtp %></span>
        </div>
      <% } %>

      <form action="/reset-password" method="POST">
        <% if (typeof email !== 'undefined' && email) { %>
          <input type="hidden" name="email" value="<%= email %>">
        <% } else { %>
          <div class="form-group">
            <label class="form-label" for="resetEmail">Email Address</label>
            <input type="email" id="resetEmail" name="email" class="form-control" placeholder="name@example.com" required autofocus>
          </div>
        <% } %>

        <% if (typeof token !== 'undefined' && token) { %>
          <input type="hidden" name="token" value="<%= token %>">
        <% } %>

        <% if (typeof validToken === 'undefined' || !validToken) { %>
          <div class="form-group" style="text-align: center;">
            <label class="form-label" for="otp" style="margin-bottom: 0.5rem;">Enter 6-Digit Reset Code</label>
            <input 
              type="text" 
              id="otp" 
              name="otp" 
              class="form-control" 
              placeholder="123456" 
              maxlength="6" 
              pattern="[0-9]{6}" 
              inputmode="numeric" 
              required 
              style="text-align: center; font-size: 1.5rem; letter-spacing: 0.3em; font-family: monospace; font-weight: 700; padding: 0.6rem;"
              value="<%= typeof devOtp !== 'undefined' && devOtp ? devOtp : '' %>"
            >
          </div>
        <% } %>

        <div class="form-group">
          <label class="form-label" for="password">New Password</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            class="form-control" 
            placeholder="Minimum 6 characters" 
            minlength="6" 
            required
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="confirmPassword">Confirm New Password</label>
          <input 
            type="password" 
            id="confirmPassword" 
            name="confirmPassword" 
            class="form-control" 
            placeholder="Re-enter new password" 
            minlength="6" 
            required
          >
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem; margin-top: 0.5rem;">
          Update Password & Sign In
        </button>
      </form>

      <div style="margin-top: 1.5rem; text-align: center; font-size: 0.875rem; color: var(--text-muted);">
        Remembered your password? <a href="/login" style="color: var(--secondary); font-weight: 600; text-decoration: none;">Back to Sign In</a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

