# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/bill_management

# Authentication & AES-256 Encryption Keys
JWT_SECRET=production-grade-jwt-secret-key-for-tax-audit-system-2026
ENCRYPTION_KEY=aes-256-gcm-master-encryption-key-for-user-keys-32b

# AI Service Endpoints & Defaults
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Nodemailer SMTP Configuration
# For Gmail:
#   SMTP_SERVICE=gmail
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASS=your_16_char_app_password
#
# For Custom SMTP (Mailtrap, Brevo, SendGrid):
#   SMTP_HOST=smtp.mailtrap.io
#   SMTP_PORT=587
#   SMTP_USER=your_smtp_username
#   SMTP_PASS=your_smtp_password
#
# Primary Email Transporter Credentials (Gmail / SMTP):
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# Optional Custom SMTP (Mailtrap, Brevo, SendGrid):
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Audit & Tax Bill Manager" <alerts@taxbillmanager.com>
