<%- include('partials/header') %>

<div style="min-height: calc(100vh - 80px); display: flex; align-items: center; justify-content: center; padding: 2rem 1rem;">
  <div class="card" style="width: 100%; max-width: 480px; box-shadow: var(--shadow-lg);">
    <div class="card-header" style="flex-direction: column; align-items: flex-start; gap: 0.5rem; padding: 2rem 2rem 1.5rem 2rem; background: linear-gradient(to bottom, #ffffff, #f8fafc);">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <div style="background: linear-gradient(135deg, #10b981, #059669); color: white; width: 42px; height: 42px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">🛡️</div>
        <div>
          <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--dark);">Create Auditor Account</h2>
          <p style="font-size: 0.85rem; color: var(--text-muted);">AI-Powered Audit & Tax Management System</p>
        </div>
      </div>
    </div>

    <div class="card-body" style="padding: 2rem;">
      <% if (typeof error !== 'undefined' && error) { %>
        <div style="background-color: var(--danger-light); border: 1px solid var(--danger-border); color: #991b1b; padding: 0.75rem 1rem; border-radius: var(--radius-sm); margin-bottom: 1.25rem; font-size: 0.9rem;">
          ⚠️ <%= error %>
        </div>
      <% } %>

      <form action="/register" method="POST">
        <div class="form-group">
          <label class="form-label" for="name">Full Name</label>
          <input type="text" id="name" name="name" class="form-control" placeholder="Alex Morgan, CPA" required autofocus>
        </div>

        <div class="form-group">
          <label class="form-label" for="email">Work Email Address</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="alex@auditfirm.com" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password (Minimum 6 characters)</label>
          <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" minlength="6" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="role">Auditor Role</label>
          <select id="role" name="role" class="form-control">
            <option value="Auditor">Lead Tax Auditor</option>
            <option value="Accountant">Senior Corporate Accountant</option>
            <option value="Admin">Finance Compliance Officer</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem; margin-top: 0.5rem; background-color: var(--success); border-color: var(--success);">
          Register & Initialize Default Tax Categories &rarr;
        </button>
      </form>

      <div style="margin-top: 1.5rem; text-align: center; font-size: 0.9rem; color: var(--text-muted);">
        Already registered? <a href="/login" style="color: var(--primary); font-weight: 600; text-decoration: none;">Sign In</a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

