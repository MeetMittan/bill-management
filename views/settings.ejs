<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container" style="max-width: 680px; margin: 2rem auto;">
  <div class="page-header" style="margin-bottom: 2rem;">
    <div>
      <h1 class="page-title">Account Settings</h1>
      <p class="page-subtitle">Manage your profile details and automated bill reminder preferences.</p>
    </div>
  </div>

  <% if (success) { %>
    <div class="alert alert-success" style="margin-bottom: 1.5rem;">
      <%= success %>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-error" style="margin-bottom: 1.5rem;">
      <%= error %>
    </div>
  <% } %>

  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Profile Information</h3>
    </div>
    <div class="card-body" style="padding: 1.75rem;">
      <form id="settings-form">
        <div class="form-group" style="margin-bottom: 1.5rem;">
          <label class="form-label" for="userName">Full Name</label>
          <input 
            type="text" 
            id="userName" 
            name="name" 
            class="form-control" 
            value="<%= user.name %>" 
            required 
            placeholder="e.g. Meet Kumar"
          >
          <small style="color: var(--text-muted); display: block; margin-top: 0.35rem; font-size: 0.8rem;">
            Display name format: <strong><%= user.formattedName || user.name %></strong>
          </small>
        </div>

        <div class="form-group" style="margin-bottom: 1.5rem;">
          <label class="form-label" for="userEmail">Email Address</label>
          <input 
            type="email" 
            id="userEmail" 
            class="form-control" 
            value="<%= user.email %>" 
            disabled 
            style="background-color: var(--bg-hover); cursor: not-allowed;"
          >
          <small style="color: var(--text-muted); display: block; margin-top: 0.35rem; font-size: 0.8rem;">
            Verified primary email used for account authentication and alerts.
          </small>
        </div>

        <hr style="border: none; border-top: 1px solid var(--border-color); margin: 1.75rem 0;" />

        <div style="margin-bottom: 1.5rem;">
          <h4 style="font-size: 0.95rem; font-weight: 600; color: var(--text-main); margin-bottom: 0.5rem;">
            Notification Preferences
          </h4>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
            Control automated notifications sent to your registered email address.
          </p>
          <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
            <input 
              type="checkbox" 
              id="emailAlertsEnabled" 
              name="emailAlertsEnabled" 
              value="true" 
              <%= user.emailAlertsEnabled !== false ? 'checked' : '' %> 
              style="width: 18px; height: 18px; margin-top: 2px; cursor: pointer;"
            >
            <label for="emailAlertsEnabled" style="font-size: 0.9rem; cursor: pointer; color: var(--text-main); line-height: 1.4;">
              Send automated payment reminders 3 days before a bill reaches its due date.
            </label>
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem;">
          <button type="submit" id="btn-save-settings" class="btn btn-primary" style="padding: 0.65rem 1.75rem;">
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
