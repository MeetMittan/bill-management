<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container" style="max-width: 820px;">
  <div class="page-header">
    <div>
      <h1 class="page-title">Upload & Process Bill</h1>
      <p class="page-subtitle">Upload your invoice or receipt (PDF, PNG, JPG). Line items, taxes, and amounts are automatically extracted and verified.</p>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Select Invoice Document</h3>
    </div>

    <div class="card-body" style="padding: 2rem;">
      <form id="bill-upload-form" enctype="multipart/form-data">
        <!-- Drag & Drop Upload Zone -->
        <div id="upload-dropzone" class="upload-dropzone">
          <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-main);">
            Drag and drop your file here, or browse
          </h3>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.25rem;">
            Supports PDF, PNG, JPG, JPEG (Up to 10MB)
          </p>
          <input type="file" id="billFile" name="billFile" accept=".pdf,.png,.jpg,.jpeg,.webp" style="display: none;" required>
          <button type="button" class="btn btn-secondary" onclick="document.getElementById('billFile').click()">
            Choose File
          </button>
          <div id="selected-file-name" style="margin-top: 1rem; font-weight: 600; font-size: 0.9rem; color: var(--primary);"></div>
        </div>

        <!-- Dynamic Multi-Step Progress Indicator -->
        <div id="upload-progress-box" style="display: none; margin-top: 1.5rem; background: var(--bg-hover); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1.25rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span id="upload-status-label" style="font-weight: 500; font-size: 0.9rem; color: var(--text-main);">
              Processing invoice document...
            </span>
            <span style="font-size: 0.85rem; color: var(--text-muted);">Please wait</span>
          </div>
          <div style="background-color: var(--border-color); border-radius: 6px; height: 8px; overflow: hidden;">
            <div id="upload-progress-bar" style="background-color: var(--primary); width: 10%; height: 100%; transition: width 0.4s ease;"></div>
          </div>
        </div>

        <div class="form-submit-actions">
          <button type="submit" id="btn-upload-submit" class="btn btn-primary" style="padding: 0.75rem 2rem; font-size: 0.95rem;">
            Upload & Verify Bill
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Compliance Information Guide -->
  <div class="compliance-guide-grid">
    <div class="card" style="padding: 1.25rem; margin-bottom: 0;">
      <h4 style="font-size: 0.95rem; font-weight: 600; color: var(--text-main); margin-bottom: 0.4rem;">
        1. Automated Reading
      </h4>
      <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5;">
        Extracts vendor name, invoice date, due date, items, tax amount, and grand total.
      </p>
    </div>

    <div class="card" style="padding: 1.25rem; margin-bottom: 0;">
      <h4 style="font-size: 0.95rem; font-weight: 600; color: var(--text-main); margin-bottom: 0.4rem;">
        2. Smart Categorization
      </h4>
      <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5;">
        Automatically assigns bills to matching categories or creates new ones as needed.
      </p>
    </div>

    <div class="card" style="padding: 1.25rem; margin-bottom: 0;">
      <h4 style="font-size: 0.95rem; font-weight: 600; color: var(--text-main); margin-bottom: 0.4rem;">
        3. Strict Math & Audit
      </h4>
      <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5;">
        Ensures Subtotal + Tax matches Grand Total exactly. Rejects mismatched submissions to keep records clean.
      </p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
