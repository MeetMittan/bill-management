<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container">
  <div class="page-header">
    <div>
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <h1 class="page-title"><%= bill.vendorName %></h1>
        <span id="status-badge-<%= bill._id %>" class="badge badge-<%= bill.paymentStatus.toLowerCase() %>">
          <%= bill.paymentStatus %>
        </span>
      </div>
      <p class="page-subtitle">
        Invoice #<%= bill.invoiceNumber || 'N/A' %> &bull; Uploaded on <%= new Date(bill.createdAt).toLocaleDateString() %> &bull; Category: <%= bill.categoryName %>
      </p>
    </div>

    <div class="header-actions no-print">
      <button type="button" class="pii-mask-toggle btn btn-secondary btn-sm" data-bill-id="<%= bill._id %>" data-target=".pii-target">
        <%= bill.piiMasked ? 'Reveal Data' : 'Mask Sensitive Data' %>
      </button>
      <button type="button" class="btn btn-secondary btn-sm btn-status-toggle" data-bill-id="<%= bill._id %>">
        <%= bill.paymentStatus === 'Paid' ? 'Mark as Due' : 'Mark as Paid' %>
      </button>
      <button type="button" onclick="window.print()" class="btn btn-secondary btn-sm">
        Print Summary
      </button>
      <button type="button" onclick="deleteBill('<%= bill._id %>')" class="btn btn-danger btn-sm">
        Delete
      </button>
    </div>
  </div>

  <!-- Audit Alerts Banner -->
  <% if (bill.auditFlags?.mathDiscrepancy) { %>
    <div class="alert alert-error" style="margin-bottom: 1.5rem;">
      <div>
        <strong>Calculation Mismatch:</strong>
        <p style="margin-top: 0.25rem;">
          <%= bill.auditFlags.mathDiscrepancyDetails || 'Subtotal + Tax Amount must equal Grand Total. Please adjust the numbers to proceed.' %>
        </p>
      </div>
    </div>
  <% } %>

  <% if (bill.auditFlags?.duplicateReceipt) { %>
    <div class="alert alert-warning" style="margin-bottom: 1.5rem;">
      <div>
        <strong>Potential Duplicate Bill:</strong>
        <p style="margin-top: 0.25rem;">
          An invoice with matching vendor, date, or invoice number already exists in your records.
        </p>
      </div>
    </div>
  <% } %>

  <% if (bill.auditFlags?.missingTaxId) { %>
    <div class="alert alert-warning" style="margin-bottom: 1.5rem;">
      <div>
        <strong>Tax ID Missing:</strong>
        <span style="display: block; margin-top: 0.25rem;">
          No GSTIN or Tax Registration Number was detected. Tax credit may require manual verification.
        </span>
      </div>
    </div>
  <% } %>

  <div class="detail-grid">
    <!-- Left Column: Verification Form & Itemized Costs -->
    <div>
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Bill Details</h3>
          <span style="font-size: 0.8rem; color: var(--text-muted);">Ensure Subtotal + Tax equals Grand Total</span>
        </div>
        <div class="card-body">
          <form id="edit-bill-form">
            <div class="form-row-grid">
              <div class="form-group">
                <label class="form-label" for="vendorName">Vendor Name</label>
                <input type="text" id="vendorName" name="vendorName" class="form-control" value="<%= bill.vendorName %>" required>
              </div>

              <div class="form-group">
                <label class="form-label" for="firmName">Firm / Client Name</label>
                <input type="text" id="firmName" name="firmName" class="form-control" value="<%= bill.firmName || '' %>" placeholder="Buyer organization">
              </div>

              <div class="form-group">
                <label class="form-label" for="invoiceNumber">Invoice Number</label>
                <input type="text" id="invoiceNumber" name="invoiceNumber" class="form-control pii-target <%= bill.piiMasked ? 'pii-masked' : '' %>" value="<%= bill.invoiceNumber || '' %>">
              </div>

              <div class="form-group">
                <label class="form-label" for="category">Category</label>
                <select id="category" name="category" class="form-control">
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat._id %>" <%= (bill.category && bill.category._id.toString() == cat._id.toString()) ? 'selected' : '' %>>
                      <%= cat.name %>
                    </option>
                  <% }); %>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="billDate">Bill Date</label>
                <input type="date" id="billDate" name="billDate" class="form-control" value="<%= bill.billDate ? new Date(bill.billDate).toISOString().split('T')[0] : '' %>">
              </div>

              <div class="form-group">
                <label class="form-label" for="dueDate">Due Date</label>
                <input type="date" id="dueDate" name="dueDate" class="form-control" value="<%= bill.dueDate ? new Date(bill.dueDate).toISOString().split('T')[0] : '' %>">
              </div>

              <div class="form-group">
                <label class="form-label" for="taxId">Tax Registration ID (GSTIN / VAT)</label>
                <input type="text" id="taxId" name="taxId" class="form-control pii-target <%= bill.piiMasked ? 'pii-masked' : '' %>" value="<%= bill.taxId || '' %>" placeholder="e.g. 29ABCDE1234F1Z5">
              </div>

              <div class="form-group">
                <label class="form-label" for="paymentStatus">Payment Status</label>
                <select id="paymentStatus" name="paymentStatus" class="form-control">
                  <option value="Due" <%= bill.paymentStatus === 'Due' ? 'selected' : '' %>>Due</option>
                  <option value="Paid" <%= bill.paymentStatus === 'Paid' ? 'selected' : '' %>>Paid</option>
                </select>
              </div>
            </div>

            <!-- Financial Calculations Section -->
            <div style="background-color: var(--bg-hover); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1.25rem; margin: 1.25rem 0;">
              <h4 style="font-size: 0.9rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text-main);">
                Financial Amounts (in ₹)
              </h4>
              <div class="math-inputs-grid">
                <div class="form-group">
                  <label class="form-label" for="subtotal">Subtotal (₹)</label>
                  <input type="number" step="0.01" min="0" id="subtotal" name="subtotal" class="form-control" value="<%= (bill.subtotal || 0).toFixed(2) %>" required>
                </div>

                <div class="form-group">
                  <label class="form-label" for="taxAmount">Tax Amount (₹)</label>
                  <input type="number" step="0.01" min="0" id="taxAmount" name="taxAmount" class="form-control" value="<%= (bill.taxAmount || 0).toFixed(2) %>" required>
                </div>

                <div class="form-group">
                  <label class="form-label" for="grandTotal">Grand Total (₹)</label>
                  <input type="number" step="0.01" min="0" id="grandTotal" name="grandTotal" class="form-control" style="font-weight: 600;" value="<%= (bill.grandTotal || 0).toFixed(2) %>" required>
                </div>
              </div>
              <small style="color: var(--text-muted); display: block; margin-top: 0.5rem; font-size: 0.8rem;">
                Strict rule: Subtotal + Tax Amount must exactly match Grand Total.
              </small>
            </div>

            <% if (bill.auditFlags?.needsManualReview) { %>
              <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem;">
                <input type="checkbox" id="clearReviewFlag" name="clearReviewFlag" value="true" checked style="width: 16px; height: 16px;">
                <label for="clearReviewFlag" style="font-size: 0.85rem; color: var(--text-main); cursor: pointer;">
                  Mark this bill as reviewed and verified
                </label>
              </div>
            <% } %>

            <div style="display: flex; justify-content: flex-end;" class="no-print">
              <button type="submit" id="btn-save-bill" class="btn btn-primary">
                Save Changes
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Itemized Costs Breakdown -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Itemized Line Items</h3>
        </div>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Description</th>
                <th>Quantity</th>
                <th>Unit Price (₹)</th>
                <th>Total (₹)</th>
              </tr>
            </thead>
            <tbody>
              <% if (bill.itemizedCosts && bill.itemizedCosts.length > 0) { %>
                <% bill.itemizedCosts.forEach(item => { %>
                  <tr>
                    <td><%= item.description %></td>
                    <td><%= item.quantity %></td>
                    <td>₹<%= (item.unitPrice || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                    <td><strong>₹<%= (item.amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="4" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">
                    No individual line items listed. Recorded as single invoice total.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Right Column: Document Preview & Audit Notes Thread -->
    <div>
      <!-- Uploaded Document File Preview (Download button removed as per requirement) -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Original Document</h3>
        </div>
        <div class="card-body" style="text-align: center; padding: 1.25rem;">
          <% if (bill.filePath) { %>
            <% if (bill.fileMimeType && bill.fileMimeType.includes('pdf')) { %>
              <div style="padding: 2rem 1rem; background: var(--bg-hover); border: 1px dashed var(--border-color); border-radius: var(--radius-sm);">
                <p style="font-weight: 600; font-size: 0.95rem; margin-bottom: 0.25rem;"><%= bill.originalFileName || 'Invoice.pdf' %></p>
                <small style="color: var(--text-muted);"><%= ((bill.fileSize || 0) / 1024).toFixed(1) %> KB</small>
                <div style="margin-top: 1rem;">
                  <a href="<%= bill.filePath %>" target="_blank" class="btn btn-secondary btn-sm">
                    Open PDF in Viewer &rarr;
                  </a>
                </div>
              </div>
            <% } else { %>
              <div class="pii-target <%= bill.piiMasked ? 'pii-masked' : '' %>" style="overflow: hidden; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                <img src="<%= bill.filePath %>" alt="Uploaded Invoice" style="max-width: 100%; height: auto; display: block; margin: 0 auto;">
              </div>
            <% } %>
          <% } else { %>
            <p style="color: var(--text-muted); padding: 2rem;">No file uploaded for this invoice.</p>
          <% } %>
        </div>
      </div>

      <!-- Internal Audit Notes -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Audit Notes</h3>
        </div>
        <div class="card-body" style="padding: 1.25rem;">
          <div id="notes-container" style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.25rem; max-height: 280px; overflow-y: auto;">
            <% if (bill.notes && bill.notes.length > 0) { %>
              <% bill.notes.forEach(note => { %>
                <div style="background-color: var(--bg-hover); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 0.75rem;">
                  <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.25rem;">
                    <strong><%= note.author %></strong>
                    <span><%= new Date(note.createdAt).toLocaleDateString() %></span>
                  </div>
                  <div style="font-size: 0.85rem; color: var(--text-main);"><%= note.text %></div>
                </div>
              <% }); %>
            <% } else { %>
              <p id="no-notes-msg" style="color: var(--text-muted); font-size: 0.85rem;">No notes recorded yet.</p>
            <% } %>
          </div>

          <form id="add-note-form" class="no-print">
            <div class="form-group" style="margin-bottom: 0.75rem;">
              <textarea id="noteText" name="noteText" class="form-control" rows="2" placeholder="Add an observation or audit note..." required></textarea>
            </div>
            <button type="submit" id="btn-add-note" class="btn btn-secondary btn-sm" style="width: 100%;">
              Add Note
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Handle Bill Edit Submission
  const editForm = document.getElementById('edit-bill-form');
  if (editForm) {
    editForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('btn-save-bill');
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.innerText = 'Saving...';
      }

      const formData = new FormData(editForm);
      const data = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/bills/<%= bill._id %>', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) {
          showToast(result.message || 'Bill updated successfully', 'success');
          setTimeout(() => window.location.reload(), 600);
        } else {
          showToast(result.message || 'Unable to update bill', 'error');
          if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.innerText = 'Save Changes';
          }
        }
      } catch (err) {
        showToast('A network error occurred while updating the bill.', 'error');
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.innerText = 'Save Changes';
        }
      }
    });
  }

  // Handle Note Submission without page jumping
  const noteForm = document.getElementById('add-note-form');
  if (noteForm) {
    noteForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const noteInput = document.getElementById('noteText');
      const submitBtn = document.getElementById('btn-add-note');
      const text = noteInput.value.trim();
      if (!text) return;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Saving...';
      }

      try {
        const res = await fetch('/api/bills/<%= bill._id %>/notes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ noteText: text })
        });
        const result = await res.json();
        if (result.success) {
          showToast('Audit note added', 'success');
          const noMsg = document.getElementById('no-notes-msg');
          if (noMsg) noMsg.remove();

          const container = document.getElementById('notes-container');
          const newDiv = document.createElement('div');
          newDiv.style.backgroundColor = 'var(--bg-hover)';
          newDiv.style.border = '1px solid var(--border-color)';
          newDiv.style.borderRadius = 'var(--radius-sm)';
          newDiv.style.padding = '0.75rem';
          newDiv.innerHTML = `
            <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.25rem;">
              <strong>${result.note.author}</strong>
              <span>Just now</span>
            </div>
            <div style="font-size: 0.85rem; color: var(--text-main);">${result.note.text}</div>
          `;
          container.prepend(newDiv);
          noteInput.value = '';
        } else {
          showToast(result.message || 'Failed to save note', 'error');
        }
      } catch (err) {
        showToast('Failed to add note. Please try again.', 'error');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Add Note';
        }
      }
    });
  }
</script>

<%- include('partials/footer') %>
