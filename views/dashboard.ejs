<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container">
  <div class="page-header">
    <div>
      <h1 class="page-title">Audit & Tax Dashboard</h1>
      <p class="page-subtitle">Real-time overview of expenses, tax credits, compliance checks, and payment statuses.</p>
    </div>
    <div class="header-actions">
      <a href="/api/analytics/export-csv?type=categories" class="btn btn-secondary">
        Category Report (CSV)
      </a>
      <a href="/api/analytics/export-csv?type=bills" class="btn btn-secondary">
        Export All (CSV)
      </a>
      <a href="/upload" class="btn btn-primary">
        Upload Bill
      </a>
    </div>
  </div>

  <!-- KPI Overview Grid -->
  <div class="kpi-grid">
    <div class="kpi-card">
      <div class="kpi-header">
        <span class="kpi-title">Total Spending</span>
      </div>
      <div class="kpi-value">₹<%= (kpis.totalSpend || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
      <div class="kpi-subtitle">Across <%= kpis.totalBills || 0 %> bills</div>
    </div>

    <div class="kpi-card">
      <div class="kpi-header">
        <span class="kpi-title">Total Tax Paid</span>
      </div>
      <div class="kpi-value">₹<%= (kpis.totalTaxPaid || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
      <div class="kpi-subtitle">Input Tax Credit (GST/VAT)</div>
    </div>

    <div class="kpi-card">
      <div class="kpi-header">
        <span class="kpi-title">Pending Due</span>
      </div>
      <div class="kpi-value">₹<%= (kpis.dueSpend || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
      <div class="kpi-subtitle"><%= kpis.dueCount || 0 %> unpaid bills</div>
    </div>

    <div class="kpi-card">
      <div class="kpi-header">
        <span class="kpi-title">Audit Alerts</span>
      </div>
      <div class="kpi-value"><%= (kpis.mathDiscrepancies || 0) + (kpis.duplicates || 0) %></div>
      <div class="kpi-subtitle">
        <%= kpis.mathDiscrepancies || 0 %> calculation errors &bull; <%= kpis.duplicates || 0 %> duplicates
      </div>
    </div>
  </div>

  <!-- Analytics & Visual Breakdown -->
  <div class="chart-grid">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Spending & Tax Trend</h3>
        <span style="font-size: 0.8rem; color: var(--text-muted);">Monthly comparison</span>
      </div>
      <div class="card-body" style="height: 300px; position: relative;">
        <canvas id="monthlyTrendChart"></canvas>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Category Breakdown</h3>
        <a href="/bills" style="font-size: 0.8rem; color: var(--primary); text-decoration: none; font-weight: 500;">View all &rarr;</a>
      </div>
      <div class="card-body" style="height: 300px; position: relative;">
        <canvas id="categoryPieChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Recent Bills Table -->
  <div class="card">
    <div class="card-header">
      <div>
        <h3 class="card-title">Recent Invoices</h3>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.2rem;">Latest uploaded bills and verification statuses.</p>
      </div>
      <div style="display: flex; gap: 0.5rem;">
        <a href="/bills" class="btn btn-secondary btn-sm">All Invoices &rarr;</a>
      </div>
    </div>

    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Vendor</th>
            <th>Invoice #</th>
            <th>Category</th>
            <th>Date</th>
            <th>Subtotal</th>
            <th>Tax</th>
            <th>Total (₹)</th>
            <th>Status</th>
            <th>Audit</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentBills && recentBills.length > 0) { %>
            <% recentBills.forEach(bill => { %>
              <tr>
                <td>
                  <strong><%= bill.vendorName %></strong>
                  <% if (bill.firmName) { %>
                    <br><small style="color: var(--text-muted);"><%= bill.firmName %></small>
                  <% } %>
                </td>
                <td>
                  <code><%= bill.invoiceNumber || '—' %></code>
                </td>
                <td>
                  <span class="badge badge-info">
                    <%= bill.categoryName || 'General' %>
                  </span>
                </td>
                <td><%= bill.billDate ? new Date(bill.billDate).toLocaleDateString() : '—' %></td>
                <td>₹<%= (bill.subtotal || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                <td>₹<%= (bill.taxAmount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                <td>
                  <strong>₹<%= (bill.grandTotal || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong>
                </td>
                <td>
                  <span id="status-badge-<%= bill._id %>" class="badge badge-<%= bill.paymentStatus.toLowerCase() %>">
                    <%= bill.paymentStatus %>
                  </span>
                </td>
                <td>
                  <% if (bill.auditFlags?.mathDiscrepancy) { %>
                    <span class="badge badge-danger">Math Mismatch</span>
                  <% } else if (bill.auditFlags?.duplicateReceipt) { %>
                    <span class="badge badge-warning">Duplicate</span>
                  <% } else if (bill.auditFlags?.missingTaxId) { %>
                    <span class="badge badge-warning">No Tax ID</span>
                  <% } else { %>
                    <span class="badge badge-paid">Verified</span>
                  <% } %>
                </td>
                <td>
                  <div style="display: flex; gap: 0.4rem;">
                    <button type="button" class="btn btn-secondary btn-sm btn-status-toggle" data-bill-id="<%= bill._id %>">
                      <%= bill.paymentStatus === 'Paid' ? 'Mark Due' : 'Mark Paid' %>
                    </button>
                    <a href="/bills/<%= bill._id %>" class="btn btn-secondary btn-sm">
                      Details
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="10" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
                <p style="font-weight: 500; font-size: 1rem; color: var(--text-main); margin-bottom: 0.5rem;">No invoices uploaded yet</p>
                <p style="font-size: 0.85rem; margin-bottom: 1.25rem;">Upload your first invoice to automatically extract details and run verification checks.</p>
                <a href="/upload" class="btn btn-primary btn-sm">Upload Invoice</a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Upcoming Due Dates Section -->
  <% if (upcomingDueBills && upcomingDueBills.length > 0) { %>
    <div class="card" style="margin-top: 1.5rem;">
      <div class="card-header">
        <h3 class="card-title">Upcoming Due Bills</h3>
      </div>
      <div class="card-body" style="padding: 1rem 1.5rem;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
          <% upcomingDueBills.forEach(b => { %>
            <div style="background-color: var(--bg-hover); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1rem; display: flex; justify-content: space-between; align-items: center;">
              <div>
                <strong><%= b.vendorName %></strong>
                <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.2rem;">Due: <%= new Date(b.dueDate).toLocaleDateString() %></div>
              </div>
              <div style="text-align: right;">
                <div style="font-size: 1rem; font-weight: 700; color: var(--text-main);">
                  ₹<%= (b.grandTotal || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </div>
                <button type="button" class="btn btn-secondary btn-sm btn-status-toggle" data-bill-id="<%= b._id %>" style="margin-top: 0.35rem;">Mark Paid</button>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  <% } %>
</div>

<script src="/js/dashboardCharts.js"></script>
<%- include('partials/footer') %>
