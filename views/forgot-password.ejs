<%- include('partials/header') %>

<div class="auth-container">
  <div class="card auth-card" style="max-width: 440px;">
    <div class="card-header auth-card-header">
      <h2 style="font-size: 1.35rem; font-weight: 700; color: var(--dark); margin: 0;">Forgot Password</h2>
      <p style="font-size: 0.875rem; color: var(--text-muted); margin-top: 0.25rem;">
        Enter your registered email address to receive a 6-digit password reset code.
      </p>
    </div>

    <div class="card-body auth-card-body">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-box alert-error">
          <%= error %>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert-box alert-success" style="background-color: var(--success-light); border: 1px solid var(--success-border); color: var(--success); padding: 0.75rem 1rem; border-radius: var(--radius-sm); margin-bottom: 1.25rem; font-size: 0.875rem; text-align: center;">
          <%= success %>
        </div>
      <% } %>

      <form action="/forgot-password" method="POST">
        <div class="form-group">
          <label class="form-label" for="email">Registered Email Address</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-control" 
            placeholder="name@example.com" 
            required 
            autofocus
            value="<%= typeof email !== 'undefined' ? email : '' %>"
          >
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem; margin-top: 0.5rem;">
          Send Reset Code
        </button>
      </form>

      <div style="margin-top: 1.5rem; text-align: center; font-size: 0.875rem; color: var(--text-muted);">
        Remember your password? <a href="/login" style="color: var(--secondary); font-weight: 600; text-decoration: none;">Back to Sign In</a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
