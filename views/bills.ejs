<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container">
  <div class="page-header">
    <div>
      <h1 class="page-title">Bills Registry</h1>
      <p class="page-subtitle">Search, filter, verify tax compliance, and manage invoice settlement status.</p>
    </div>
    <div class="header-actions">
      <a href="/api/analytics/export-csv?type=bills" class="btn btn-secondary">
        Export CSV
      </a>
      <a href="/upload" class="btn btn-primary">
        Upload Bill
      </a>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-body" style="padding: 1.25rem 1.5rem;">
      <form action="/bills" method="GET" class="bills-filter-form">
        <div>
          <label class="form-label" for="search">Keyword Search</label>
          <input type="text" id="search" name="search" class="form-control" placeholder="Vendor, Firm, Inv #, Tax ID" value="<%= query.search || '' %>">
        </div>

        <div>
          <label class="form-label" for="category">Category</label>
          <select id="category" name="category" class="form-control">
            <option value="all">All Categories</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat._id %>" <%= query.category == cat._id.toString() ? 'selected' : '' %>>
                <%= cat.name %>
              </option>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="form-label" for="status">Payment Status</label>
          <select id="status" name="status" class="form-control">
            <option value="">All Statuses</option>
            <option value="Due" <%= query.status === 'Due' ? 'selected' : '' %>>Due (Unpaid)</option>
            <option value="Paid" <%= query.status === 'Paid' ? 'selected' : '' %>>Paid</option>
          </select>
        </div>

        <div>
          <label class="form-label" for="auditFilter">Audit Filter</label>
          <select id="auditFilter" name="auditFilter" class="form-control">
            <option value="">All Records</option>
            <option value="mathDiscrepancy" <%= query.auditFilter === 'mathDiscrepancy' ? 'selected' : '' %>>Math Mismatch</option>
            <option value="duplicate" <%= query.auditFilter === 'duplicate' ? 'selected' : '' %>>Duplicate Receipt</option>
            <option value="missingTaxId" <%= query.auditFilter === 'missingTaxId' ? 'selected' : '' %>>Missing Tax ID</option>
            <option value="needsManualReview" <%= query.auditFilter === 'needsManualReview' ? 'selected' : '' %>>Needs Review</option>
          </select>
        </div>

        <div>
          <label class="form-label" for="startDate">From Date</label>
          <input type="date" id="startDate" name="startDate" class="form-control" value="<%= query.startDate || '' %>">
        </div>

        <div>
          <label class="form-label" for="endDate">To Date</label>
          <input type="date" id="endDate" name="endDate" class="form-control" value="<%= query.endDate || '' %>">
        </div>

        <div class="filter-btn-group">
          <button type="submit" class="btn btn-primary" style="flex: 1;">Filter</button>
          <a href="/bills" class="btn btn-secondary" title="Clear Filters">Reset</a>
        </div>
      </form>
    </div>
  </div>

  <!-- Bills Registry Table -->
  <div class="card">
    <div class="card-header">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <h3 class="card-title">Invoices (<%= totalCount %> found)</h3>
        <% if (query.auditFilter === 'mathDiscrepancy') { %>
          <span class="badge badge-danger">Filtering: Math Mismatch</span>
        <% } %>
      </div>
      <div style="font-size: 0.85rem; color: var(--text-muted);">
        Page <%= currentPage %> of <%= totalPages %>
      </div>
    </div>

    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Vendor Name</th>
            <th>Invoice #</th>
            <th>Category</th>
            <th>Bill Date</th>
            <th>Due Date</th>
            <th>Subtotal</th>
            <th>Tax</th>
            <th>Total (₹)</th>
            <th>Status</th>
            <th>Audit Checks</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (bills && bills.length > 0) { %>
            <% bills.forEach(bill => { %>
              <tr>
                <td>
                  <strong><%= bill.vendorName %></strong>
                  <% if (bill.firmName) { %>
                    <br><small style="color: var(--text-muted);"><%= bill.firmName %></small>
                  <% } %>
                </td>
                <td>
                  <code><%= bill.invoiceNumber || '—' %></code>
                  <% if (bill.taxId) { %>
                    <br><small style="color: var(--text-muted); font-size: 0.75rem;">ID: <%= bill.taxId %></small>
                  <% } %>
                </td>
                <td>
                  <span class="badge badge-info">
                    <%= bill.categoryName || (bill.category && bill.category.name) || 'General' %>
                  </span>
                </td>
                <td><%= bill.billDate ? new Date(bill.billDate).toLocaleDateString() : '—' %></td>
                <td><%= bill.dueDate ? new Date(bill.dueDate).toLocaleDateString() : '—' %></td>
                <td>₹<%= (bill.subtotal || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                <td>₹<%= (bill.taxAmount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                <td>
                  <strong>₹<%= (bill.grandTotal || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong>
                </td>
                <td>
                  <span id="status-badge-<%= bill._id %>" class="badge badge-<%= bill.paymentStatus.toLowerCase() %>">
                    <%= bill.paymentStatus %>
                  </span>
                </td>
                <td>
                  <% if (bill.auditFlags?.mathDiscrepancy) { %>
                    <span class="badge badge-danger" title="<%= bill.auditFlags.mathDiscrepancyDetails %>">
                      Math Error
                    </span>
                  <% } else if (bill.auditFlags?.duplicateReceipt) { %>
                    <span class="badge badge-warning" title="Duplicate receipt detected">
                      Duplicate
                    </span>
                  <% } else if (bill.auditFlags?.missingTaxId) { %>
                    <span class="badge badge-warning" title="Missing Tax ID">
                      No Tax ID
                    </span>
                  <% } else if (bill.auditFlags?.needsManualReview) { %>
                    <span class="badge badge-warning" title="Review suggested">
                      Review Needed
                    </span>
                  <% } else { %>
                    <span class="badge badge-paid">Verified</span>
                  <% } %>
                </td>
                <td>
                  <div style="display: flex; gap: 0.35rem;">
                    <button type="button" class="btn btn-secondary btn-sm btn-status-toggle" data-bill-id="<%= bill._id %>">
                      <%= bill.paymentStatus === 'Paid' ? 'Mark Due' : 'Mark Paid' %>
                    </button>
                    <a href="/bills/<%= bill._id %>" class="btn btn-secondary btn-sm">
                      Details
                    </a>
                    <button type="button" class="btn btn-danger btn-sm" onclick="deleteBill('<%= bill._id %>')" title="Delete">
                      Delete
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="11" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
                <p style="font-size: 0.95rem; font-weight: 500; margin-bottom: 0.25rem;">No matching bill records found.</p>
                <p style="font-size: 0.85rem;">Try adjusting your search criteria or date filters.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination Controls -->
    <% if (totalPages > 1) { %>
      <div style="padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-color);">
        <div style="font-size: 0.85rem; color: var(--text-muted);">
          Showing page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong> (<%= totalCount %> total bills)
        </div>
        <div style="display: flex; gap: 0.5rem;">
          <% if (currentPage > 1) { %>
            <a href="/bills?<%= new URLSearchParams({...query, page: currentPage - 1}).toString() %>" class="btn btn-secondary btn-sm">
              &larr; Previous
            </a>
          <% } %>
          <% if (currentPage < totalPages) { %>
            <a href="/bills?<%= new URLSearchParams({...query, page: currentPage + 1}).toString() %>" class="btn btn-secondary btn-sm">
              Next &rarr;
            </a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
