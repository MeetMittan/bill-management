<%- include('partials/header') %>

<div class="auth-container">
  <div class="card auth-card">
    <div class="card-header auth-card-header">
      <h2 style="font-size: 1.35rem; font-weight: 700; color: var(--dark); margin: 0;">Sign In</h2>
      <p style="font-size: 0.875rem; color: var(--text-muted); margin-top: 0.25rem;">Bill & Tax Audit Management</p>
    </div>

    <div class="card-body auth-card-body">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-box alert-error">
          <%= error %>
        </div>
      <% } %>

      <form action="/login" method="POST">
        <div class="form-group">
          <label class="form-label" for="email">Email Address</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="name@example.com" required autofocus>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <input type="password" id="password" name="password" class="form-control" placeholder="Enter password" required>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem; margin-top: 0.5rem;">
          Sign In
        </button>
      </form>

      <div style="margin-top: 1.5rem; text-align: center; font-size: 0.875rem; color: var(--text-muted);">
        Don't have an account? <a href="/register" style="color: var(--secondary); font-weight: 600; text-decoration: none;">Create Account</a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
